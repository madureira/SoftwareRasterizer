---
Language: C
BasedOnStyle: LLVM
ColumnLimit: 120
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Allman style: opening brace always on its own line
BreakBeforeBraces: Allman

# Pointer/reference aligned to the right: int *p, not int* p
PointerAlignment: Left

# Always insert braces around control flow bodies
InsertBraces: true

# No collapsing of braces or statements onto a single line
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

AlignConsecutiveMacros:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false

SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # Vendors / third-party (SDL3, emscripten, etc.)
  - Regex: '^<(SDL3|emscripten).*>'
    Priority: 2
  # STD / C system headers
  - Regex: '^<.*>'
    Priority: 1
  # Test infrastructure
  - Regex: '^"test\.h"'
    Priority: 3
  # Project headers
  - Regex: '^".*"'
    Priority: 4
