---
Language:        C
BasedOnStyle:    LLVM
ColumnLimit:     120
IndentWidth:     4
TabWidth:        4
UseTab:          Never

# Allman style: opening brace always on its own line
BreakBeforeBraces: Allman

# Pointer/reference aligned to the right: int *p, not int* p
PointerAlignment: Right

# Always insert braces around control flow bodies
InsertBraces: true

# No collapsing of braces or statements onto a single line
AllowShortBlocksOnASingleLine:     Never
AllowShortFunctionsOnASingleLine:  None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine:      false

AlignConsecutiveMacros:
  Enabled:          true
  AcrossEmptyLines: false
  AcrossComments:   false

# Preserve existing include order; do not sort or merge blocks
SortIncludes:    Never
IncludeBlocks:   Preserve
